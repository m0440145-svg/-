[Unit]
Description=Morasalat Django
After=network.target postgresql.service
[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/morasalat/backend
EnvironmentFile=/srv/morasalat/.env
ExecStart=/srv/morasalat/.venv/bin/gunicorn config.wsgi:application --workers 4 --bind 127.0.0.1:8000 --timeout 60
Restart=always
[Install]
WantedBy=multi-user.target
